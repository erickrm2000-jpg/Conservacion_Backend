@model Conservacion_frontend.Models.DashboardViewModel
@{ ViewData["Title"] = "Resumen general"; }
<div class="page-heading"><div><div class="eyebrow">PANEL DE CONTROL</div><h1>Resumen general</h1><p>Estado actual de la gestión de conservación.</p></div><span class="date-chip">2026 · Datos de demostración</span></div>
<div class="stat-grid"><div class="stat-card"><span class="stat-icon green">⌂</span><div><span>Áreas registradas</span><strong>@Model.TotalAreas</strong><small>Áreas de conservación</small></div></div><div class="stat-card"><span class="stat-icon blue">♧</span><div><span>Especies catalogadas</span><strong>@Model.TotalEspecies</strong><small>Flora y fauna</small></div></div><div class="stat-card"><span class="stat-icon purple">♙</span><div><span>Personal activo</span><strong>@Model.TotalPersonal</strong><small>Responsables registrados</small></div></div><div class="stat-card"><span class="stat-icon orange">!</span><div><span>Amenazas reportadas</span><strong>@Model.AmenazasActivas</strong><small>Requieren seguimiento</small></div></div></div>
<div class="section-header"><h2>Actividad reciente</h2><a asp-controller="Catalog" asp-action="Actividades">Ver todas →</a></div>
<div class="table-card"><table class="table align-middle mb-0"><thead><tr><th>Actividad</th><th>Área</th><th>Responsable</th><th>Inicio</th><th>Estado</th></tr></thead><tbody>@foreach (var item in Model.ActividadesRecientes) { <tr><td class="fw-semibold">@item.Nombre</td><td>@item.Area</td><td>@item.Responsable</td><td>@item.FechaInicio.ToString("dd/MM/yyyy")</td><td><span class="badge-soft green-bg">En seguimiento</span></td></tr> }</tbody></table></div>
<div class="info-banner"><span>♧</span><div><strong>Conservación basada en datos</strong><br /><small>Los módulos están preparados para conectarse a la Web API con autenticación JWT.</small></div></div>

